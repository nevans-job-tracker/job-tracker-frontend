# Loaded automatically by `vite build` (mode=production). Committed on purpose:
# it holds no secrets, and leaving it to a remembered command-line variable is
# how a build silently ends up pointing at localhost.
#
# Relative, not an absolute origin. nginx serves this app and proxies /api/ to
# the backend on the same origin (KAN-20), so the browser resolves this against
# whatever address it loaded the page from. An absolute URL here would be
# inlined at build time and bake the server's IP into the bundle, making an
# address change require a rebuild.
#
# Not loaded by `vite` in development, where VITE_API_URL stays unset and
# src/api/client.js falls back to http://localhost:8000.
VITE_API_URL=/api
